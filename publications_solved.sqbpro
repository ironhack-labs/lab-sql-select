<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="" readonly="0" foreign_keys="" case_sensitive_like="" temp_store="" wal_autocheckpoint="" synchronous=""/><attached/><window><main_tabs open="structure pragmas browser query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="735"/><column_width id="4" width="0"/></tab_structure><tab_browse><table title="." custom_title="0" dock_id="4" table="0,0:"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">SELECT
	a.au_id,
	a.au_lname,
	a.au_fname,
	t.title,
	p.pub_name
	
From authors as a
join titleauthor as ta
	ON ta.au_id = a.au_id
join titles as t
	ON ta.title_id = t.title_id
join publishers as p
	ON t.pub_id = p.pub_id;

	</sql><sql name="SQL 2">SELECT
	a.au_id,
	a.au_lname,
	a.au_fname,
	
	p.pub_name,
	COUNT(t.title_id) AS title_count
From authors as a
join titleauthor as ta
	ON ta.au_id = a.au_id
join titles as t
	ON ta.title_id = t.title_id
join publishers as p
	ON t.pub_id = p.pub_id

group by 
	a.au_id,
	a.au_lname,
	a.au_fname,
	p.pub_name
	
Order by title_count DESC;</sql><sql name="SQL 3">SELECT
	a.au_id,
	a.au_lname,
	a.au_fname,
	
	SUM(t.ytd_sales) AS total_sales
From authors as a
join titleauthor as ta
	ON ta.au_id = a.au_id
join titles as t
	ON ta.title_id = t.title_id
join publishers as p
	ON t.pub_id = p.pub_id
	
group by 
	a.au_id,
	a.au_lname,
	a.au_fname
	
ORDER by total_sales DESC
Limit 3;</sql><sql name="SQL 4*">SELECT
	a.au_id,
	a.au_lname,
	a.au_fname,
	COALESCE(SUM(t.ytd_sales), 0) AS titles_sold

	From authors as a
left join titleauthor as ta
	ON ta.au_id = a.au_id
left join titles as t
	ON ta.title_id = t.title_id
left join publishers as p
	ON t.pub_id = p.pub_id
	
group by 
	a.au_id,
	a.au_lname,
	a.au_fname
	
ORDER by titles_sold DESC
</sql><current_tab id="3"/></tab_sql></sqlb_project>
